# Every value here already has a default in docker-compose.yml.
# Copy this file to .env only if you need to override one of them.

DB_NAME=orders
DB_USER=orders
DB_PASSWORD=orders
DB_ROOT_PASSWORD=root
DB_PORT_HOST=3307

APP_CURRENCY=BRL

# fake: the local carrier simulator (default)
# http: the real HTTP adapter, which needs SHIPPING_HTTP_BASE_URL
SHIPPING_PROVIDER=fake
SHIPPING_QUOTE_TTL_SECONDS=900

HTTP_PORT=8080

# Only read when SHIPPING_PROVIDER=http
SHIPPING_HTTP_BASE_URL=https://carrier.example.com/v1/
SHIPPING_HTTP_CARRIER=Example Carrier
SHIPPING_HTTP_TIMEOUT_SECONDS=2.0
SHIPPING_HTTP_CONNECT_TIMEOUT_SECONDS=1.0
