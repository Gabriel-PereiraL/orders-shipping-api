{
    "name": "gabriel-pereiral/orders-shipping-api",
    "description": "Small orders and shipping API used as a public, verifiable sample of backend practices.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "autoload": {
        "psr-4": {
            "OrderApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OrderApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
